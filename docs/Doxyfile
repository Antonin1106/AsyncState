# docs/Doxyfile
# Configuration file for Doxygen

# =====================================================
# Project
# =====================================================
PROJECT_NAME           = "AsyncState"
PROJECT_NUMBER         = 1.0.0
OUTPUT_DIRECTORY       = docs

# =====================================================
# Input
# =====================================================
INPUT                  = src examples .
FILE_PATTERNS          = *.h *.cpp *ino README.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = /test/ /docs/**

# =====================================================
# Markdown support
# =====================================================
MARKDOWN_SUPPORT = YES
OPTIMIZE_OUTPUT_JAVA = NO
USE_MDFILE_AS_MAINPAGE = README.md

# =====================================================
# Extraction
# =====================================================
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = NO

# =====================================================
# Output formats
# =====================================================
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_TREEVIEW      = YES

# =====================================================
# Source code browser
# =====================================================
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
DISABLE_INDEX = NO
FULL_SIDEBAR = NO

# =====================================================
# Sorting
# =====================================================
SORT_MEMBER_DOCS       = YES

# =====================================================
# File paths
# =====================================================
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = src
SHOW_FILES            = YES

# =====================================================
# External CSS
# =====================================================
# The stylesheet is loaded by running the workflow "Deploy"
HTML_EXTRA_STYLESHEET  = docs/doxygen-awesome.css